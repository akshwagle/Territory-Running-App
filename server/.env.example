DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@127.0.0.1:5432/territory?schema=public
DIRECT_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@127.0.0.1:5432/territory?schema=public
DATABASE_URL_TEST=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@127.0.0.1:5432/territory_test?schema=public
DATABASE_URL_API_TEST=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@127.0.0.1:5432/territory_api_test?schema=public
ADMIN_EMAIL=YOUR_ADMIN_EMAIL
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD
POSTGRES_USER=YOUR_DB_USER
POSTGRES_PASSWORD=YOUR_DB_PASSWORD
POSTGRES_DB=territory
POSTGRES_PORT=5432
PORT=4000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost,http://localhost,capacitor://localhost
API_RATE_LIMIT_MAX=100
API_RATE_LIMIT_WINDOW_MS=60000
JWT_ACCESS_SECRET=REPLACE_WITH_AN_INDEPENDENT_RANDOM_SECRET_AT_LEAST_32_BYTES
REFRESH_TOKEN_DERIVATION_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_BYTES
GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID
MAIL_TRANSPORT=outbox
WEB_BASE_URL=http://localhost:5173
SMTP_HOST=YOUR_SMTP_HOST
SMTP_PORT=587
SMTP_USER=YOUR_SMTP_USER
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
SMTP_FROM=YOUR_FROM_ADDRESS
# Default: true in production, false in development.
# Set explicitly only when overriding that environment default.
# REQUIRE_VERIFIED_EMAIL_FOR_RUNS=true

# Policy versions: bump when the corresponding consent text changes.
LOCATION_CONSENT_VERSION=2026-11-13-run-v1
TERMS_VERSION=2026-11-13
PRIVACY_POLICY_VERSION=2026-11-13
PROFILE_WRITE_LIMIT=30
EXPORT_REQUEST_LIMIT=3

# Run compatibility, raw point retention and per-account write limit (15 min).
MIN_APP_VERSION=6
POINT_RETENTION_DAYS=365
RUN_WRITE_LIMIT=1200

# --- Production (see docs/DEPLOYMENT.md) ---
# NODE_ENV=production
# HOST=0.0.0.0                 # production refuses 127.0.0.1 unless ALLOW_LOOPBACK_HOST=true
# CORS_ORIGINS=https://YOUR_WEBSITE_ORIGIN,https://localhost,capacitor://localhost   # no http: in production
# WEB_BASE_URL=https://YOUR_WEBSITE_ORIGIN
# MAIL_TRANSPORT=smtp
# TRUST_PROXY=1                # number of reverse proxies in front of the API (rate limits use the client IP)
# SHUTDOWN_TIMEOUT_MS=10000    # grace period for in-flight requests on SIGTERM
# Hosted databases usually need SSL: append ?sslmode=require to DATABASE_URL and DIRECT_URL.
