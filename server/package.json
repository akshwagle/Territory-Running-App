{
  "name": "territory-running-database",
  "version": "0.1.0",
  "private": true,
  "description": "Territory Run PostgreSQL database and minimal Express API",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test": "node --test --test-concurrency=1 db-tests/*.test.js",
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "release:register": "node scripts/register-release.js",
    "test:api": "node --test --test-concurrency=1 api-tests/*.test.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcrypt": "6.0.0",
    "dotenv": "16.6.1",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "express-rate-limit": "8.7.4",
    "cors": "2.8.6"
  },
  "devDependencies": {
    "pg": "8.23.1",
    "prisma": "6.19.3",
    "supertest": "7.3.2"
  }
}
