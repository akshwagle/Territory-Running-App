generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SystemRole {
  RUNNER
  ADMIN
}

enum TokenKind {
  REFRESH
  PASSWORD_RESET
  EMAIL_VERIFY
}

enum AuthProvider {
  PASSWORD
  GOOGLE
}

enum TeamRole {
  CAPTAIN
  MEMBER
}

enum SeasonStatus {
  UPCOMING
  ACTIVE
  ENDED
}

enum BadgeCriteria {
  TOTAL_DISTANCE
  HEX_COUNT
  STREAK_DAYS
  RUN_COUNT
}

enum RunStatus {
  UPLOADING
  PENDING
  VALID
  FLAGGED
  REJECTED
}

enum HexOutcome {
  CAPTURED
  REFRESHED
  ON_COOLDOWN
  RESTRICTED
}

enum FlagReason {
  SPEED_LIMIT
  GPS_JUMP
  VEHICLE_PATTERN
  MOCK_LOCATION
  RESTRICTED_ZONE
  USER_REPORT
}

enum FlagStatus {
  OPEN
  DISMISSED
  CONFIRMED
}

enum NotificationType {
  HEX_LOST
  RUN_VALIDATED
  RUN_FLAGGED
  BADGE_EARNED
  SEASON_ENDED
  SYSTEM
}

model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username     String     @unique @db.VarChar(30)
  email        String     @unique @db.VarChar(255)
  passwordHash String?    @map("password_hash") @db.Text
  displayName  String     @map("display_name") @db.VarChar(60)
  role         SystemRole @default(RUNNER)
  verifiedAt   DateTime?  @map("verified_at") @db.Timestamptz(6)
  deletionAt   DateTime?  @map("deletion_at") @db.Timestamptz(6)
  suspendedAt  DateTime?  @map("suspended_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  authTokens     AuthToken[]
  authIdentities AuthIdentity[]
  privacy        UserPrivacySetting?
  membership     TeamMember?
  following      Follow[]            @relation("Follower")
  followers      Follow[]            @relation("Followee")
  badges         UserBadge[]
  seasonScores   SeasonScore[]
  stats          UserStat?
  runs           Run[]
  reportedFlags  RunFlag[]           @relation("Reporter")
  resolvedFlags  RunFlag[]           @relation("Resolver")
  ownedHexes     HexOwnership[]
  devices        Device[]
  notifications  Notification[]

  @@map("users")
}

model AuthIdentity {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  provider        AuthProvider
  providerSubject String       @map("provider_subject") @db.VarChar(255)
  emailAtSignup   String       @map("email_at_signup") @db.VarChar(255)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt      DateTime?    @map("last_used_at") @db.Timestamptz(6)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("auth_identities")
}

model AuthToken {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String      @map("user_id") @db.Uuid
  kind            TokenKind
  tokenHash       String      @unique @map("token_hash") @db.VarChar(64)
  expiresAt       DateTime    @map("expires_at") @db.Timestamptz(6)
  usedAt          DateTime?   @map("used_at") @db.Timestamptz(6)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  familyId        String?     @map("family_id") @db.Uuid
  revokedAt       DateTime?   @map("revoked_at") @db.Timestamptz(6)
  replacedById    String?     @map("replaced_by_id") @db.Uuid
  userAgent       String?     @map("user_agent") @db.Text
  ipHash          String?     @map("ip_hash") @db.VarChar(64)
  graceReplayedAt DateTime?   @map("grace_replayed_at") @db.Timestamptz(6)
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  replacedBy      AuthToken?  @relation("RefreshRotation", fields: [replacedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replaces        AuthToken[] @relation("RefreshRotation")

  @@index([userId, kind])
  @@index([familyId])
  @@map("auth_tokens")
}

model UserPrivacySetting {
  userId       String    @id @map("user_id") @db.Uuid
  hideRoute    Boolean   @default(true) @map("hide_route")
  homeHex      BigInt?   @map("home_hex")
  hideRadiusM  Int       @default(200) @map("hide_radius_m")
  consentAt    DateTime? @map("consent_at") @db.Timestamptz(6)
  termsVersion String?   @map("terms_version") @db.VarChar(10)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("user_privacy_settings")
}

model Team {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String       @unique @db.VarChar(50)
  colorHex   String       @map("color_hex") @db.VarChar(7)
  inviteCode String       @unique @map("invite_code") @db.VarChar(12)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  members    TeamMember[]

  @@map("teams")
}

model TeamMember {
  userId   String   @id @map("user_id") @db.Uuid
  teamId   String   @map("team_id") @db.Uuid
  role     TeamRole @default(MEMBER)
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  // Partial unique index for one CAPTAIN per team is in migration.sql.
  @@map("team_members")
}

model Follow {
  followerId String   @map("follower_id") @db.Uuid
  followeeId String   @map("followee_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  follower   User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  followee   User     @relation("Followee", fields: [followeeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([followerId, followeeId])
  @@map("follows")
}

model Badge {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String        @unique @db.VarChar(40)
  name        String        @db.VarChar(80)
  description String?       @db.Text
  criteria    BadgeCriteria
  threshold   Int
  users       UserBadge[]

  @@map("badges")
}

model UserBadge {
  userId    String   @map("user_id") @db.Uuid
  badgeId   String   @map("badge_id") @db.Uuid
  awardedAt DateTime @default(now()) @map("awarded_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, badgeId])
  @@map("user_badges")
}

model Season {
  id       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String        @unique @db.VarChar(60)
  startsAt DateTime      @map("starts_at") @db.Timestamptz(6)
  endsAt   DateTime      @map("ends_at") @db.Timestamptz(6)
  status   SeasonStatus  @default(UPCOMING)
  scores   SeasonScore[]

  // Partial unique index for one ACTIVE season is in migration.sql.
  @@map("seasons")
}

model SeasonScore {
  seasonId  String @map("season_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid
  hexesHeld Int    @map("hexes_held")
  distanceM BigInt @map("distance_m")
  finalRank Int    @map("final_rank")
  season    Season @relation(fields: [seasonId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([seasonId, userId])
  @@map("season_scores")
}

model UserStat {
  userId     String    @id @map("user_id") @db.Uuid
  totalRuns  Int       @default(0) @map("total_runs")
  totalDistM BigInt    @default(0) @map("total_dist_m")
  streakDays Int       @default(0) @map("streak_days")
  bestStreak Int       @default(0) @map("best_streak")
  lastRunOn  DateTime? @map("last_run_on") @db.Date
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("user_stats")
}

model Run {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  clientRunId   String         @map("client_run_id") @db.Uuid
  startedAt     DateTime       @map("started_at") @db.Timestamptz(6)
  endedAt       DateTime       @map("ended_at") @db.Timestamptz(6)
  distanceM     Int            @map("distance_m")
  durationS     Int            @map("duration_s")
  routePolyline String         @default("") @map("route_polyline") @db.Text
  h3Resolution  Int            @default(11) @map("h3_resolution") @db.SmallInt
  status        RunStatus      @default(UPLOADING)
  mockGps       Boolean        @default(false) @map("mock_gps")
  appVersion    String         @map("app_version") @db.VarChar(20)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  points        RunPoint[]
  flags         RunFlag[]
  ownedHexes    HexOwnership[]
  hexes         RunHex[]

  @@unique([userId, clientRunId])
  @@index([userId, startedAt])
  @@map("runs")
}

model RunPoint {
  id         BigInt   @id @default(autoincrement())
  runId      String   @map("run_id") @db.Uuid
  seq        Int
  lat        Float    @db.DoublePrecision
  lng        Float    @db.DoublePrecision
  recordedAt DateTime @map("recorded_at") @db.Timestamptz(6)
  accuracyM  Float    @map("accuracy_m") @db.Real
  speedMps   Float?   @map("speed_mps") @db.Real
  run        Run      @relation(fields: [runId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  // Migration uses BIGINT GENERATED BY DEFAULT AS IDENTITY, not BIGSERIAL.
  @@unique([runId, seq])
  @@map("run_points")
}

model RunFlag {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId      String          @map("run_id") @db.Uuid
  zoneId     String?         @map("zone_id") @db.Uuid
  reason     FlagReason
  details    String?         @db.Text
  status     FlagStatus      @default(OPEN)
  reporterId String?         @map("reporter_id") @db.Uuid
  resolverId String?         @map("resolver_id") @db.Uuid
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt DateTime?       @map("resolved_at") @db.Timestamptz(6)
  run        Run             @relation(fields: [runId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  zone       RestrictedZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  reporter   User?           @relation("Reporter", fields: [reporterId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  resolver   User?           @relation("Resolver", fields: [resolverId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([status, createdAt])
  @@map("run_flags")
}

model HexOwnership {
  h3Index       BigInt   @id @map("h3_index")
  ownerId       String   @map("owner_id") @db.Uuid
  runId         String   @map("run_id") @db.Uuid
  claimedAt     DateTime @default(now()) @map("claimed_at") @db.Timestamptz(6)
  cooldownUntil DateTime @map("cooldown_until") @db.Timestamptz(6)
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  run           Run      @relation(fields: [runId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([ownerId, claimedAt])
  @@map("hex_ownership")
}

model RunHex {
  runId       String     @map("run_id") @db.Uuid
  h3Index     BigInt     @map("h3_index")
  outcome     HexOutcome
  prevOwnerId String?    @map("prev_owner_id") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  run         Run        @relation(fields: [runId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  // h3Index and prevOwnerId deliberately have no foreign keys.
  @@id([runId, h3Index])
  @@index([h3Index])
  @@map("run_hexes")
}

model RestrictedZone {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String              @unique @db.VarChar(100)
  reason    String              @db.Text
  active    Boolean             @default(true)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  flags     RunFlag[]
  hexes     RestrictedZoneHex[]

  @@map("restricted_zones")
}

model RestrictedZoneHex {
  zoneId  String         @map("zone_id") @db.Uuid
  h3Index BigInt         @map("h3_index")
  zone    RestrictedZone @relation(fields: [zoneId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([zoneId, h3Index])
  @@map("restricted_zone_hexes")
}

model Region {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String       @unique @db.VarChar(80)
  city      String       @db.VarChar(80)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  cells     RegionCell[]

  @@map("regions")
}

model RegionCell {
  regionId String @map("region_id") @db.Uuid
  parentH3 BigInt @map("parent_h3")
  region   Region @relation(fields: [regionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([regionId, parentH3])
  @@map("region_cells")
}

model Device {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  fcmToken   String   @unique @map("fcm_token") @db.VarChar(255)
  platform   String   @default("ANDROID") @db.VarChar(10)
  appVersion String   @map("app_version") @db.VarChar(20)
  lastSeenAt DateTime @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@map("devices")
}

model Notification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(100)
  body      String?          @db.Text
  readAt    DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, readAt])
  @@map("notifications")
}

model AdminAction {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId    String   @map("admin_id") @db.Uuid
  action     String   @db.VarChar(50)
  targetType String   @map("target_type") @db.VarChar(30)
  targetId   String   @map("target_id") @db.Uuid
  note       String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // No foreign keys; append-only protection is in migration.sql.
  @@map("admin_actions")
}

model LoginAttempt {
  id        BigInt   @id @default(autoincrement())
  email     String   @db.VarChar(255)
  ipAddress String   @map("ip_address") @db.VarChar(45)
  success   Boolean
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // No foreign keys. Migration uses BIGINT GENERATED BY DEFAULT AS IDENTITY.
  @@index([email, createdAt])
  @@map("login_attempts")
}

model GameSetting {
  key         String   @id @db.VarChar(50)
  value       String   @db.Text
  description String?  @db.Text
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("game_settings")
}

model AppRelease {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  versionCode Int      @unique @map("version_code")
  versionName String   @map("version_name") @db.VarChar(20)
  apkUrl      String   @map("apk_url") @db.Text
  sha256      String   @db.VarChar(64)
  changelog   String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  publishedAt DateTime @default(now()) @map("published_at") @db.Timestamptz(6)

  @@map("app_releases")
}
